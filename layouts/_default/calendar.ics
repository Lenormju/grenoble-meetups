{{- define "ics-escape" -}}
{{- $s := . -}}
{{- $s = replace $s "\\" "\\\\" -}}
{{- $s = replace $s "," "\\," -}}
{{- $s = replace $s ";" "\\;" -}}
{{- $s = replace $s "\r\n" "\\n" -}}
{{- $s = replace $s "\n" "\\n" -}}
{{- $s -}}
{{- end -}}
{{- $pages := where .Site.RegularPages "Section" "meetups" -}}
{{- $pages = sort $pages "Date" -}}
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//grenoble-meetups.fr//Agenda meetups//FR
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:{{ .Site.Title }}
X-WR-TIMEZONE:Europe/Paris
{{- range $pages }}
BEGIN:VEVENT
UID:{{ .File.ContentBaseName }}@grenoble-meetups.fr
DTSTAMP:{{ (now.UTC).Format "20060102T150405Z" }}
{{- $t := partial "event-times.html" . }}
{{- /* `$t.end` est l'instant de fin inclusif ; en journée entière, DTEND est
       exclusif (RFC 5545), d'où le « +1 jour » — spécifique à l'iCal, il n'a
       lieu qu'ici. */}}
{{- if $t.allDay }}
DTSTART;VALUE=DATE:{{ $t.start.Format "20060102" }}
{{- with $t.end }}
DTEND;VALUE=DATE:{{ (.AddDate 0 0 1).Format "20060102" }}
{{- end }}
{{- else }}
DTSTART:{{ ($t.start.UTC).Format "20060102T150405Z" }}
DTEND:{{ ($t.end.UTC).Format "20060102T150405Z" }}
{{- end }}
SUMMARY:{{ template "ics-escape" .Title }}
{{- with .Params.location }}
LOCATION:{{ if .address }}{{ template "ics-escape" (printf "%s, %s" .name .address) }}{{ else }}{{ template "ics-escape" .name }}{{ end }}
{{- end }}
{{- with .Params.description }}
DESCRIPTION:{{ template "ics-escape" . }}
{{- end }}
{{- if .Params.cancelled }}
STATUS:CANCELLED
SEQUENCE:1
{{- end }}
URL:{{ .Permalink }}
END:VEVENT
{{- end }}
END:VCALENDAR
